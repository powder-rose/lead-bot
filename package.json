{
  "name": "lead-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Shared development tooling for LeadBot",
  "scripts": {
    "format": "prettier --write \"client/**/*.{js,jsx,css,html,json}\" \"server/**/*.{js,jsx,css,html,json}\"",
    "format:check": "prettier --check \"client/**/*.{js,jsx,css,html,json}\" \"server/**/*.{js,jsx,css,html,json}\"",
    "lint": "eslint --config eslint.config.mjs \"client/**/*.{js,jsx}\" \"server/**/*.js\" eslint.config.mjs",
    "lint:fix": "eslint --config eslint.config.mjs \"client/**/*.{js,jsx}\" \"server/**/*.js\" eslint.config.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
